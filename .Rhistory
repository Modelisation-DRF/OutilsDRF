# Configuration du graphe
graph [rankdir = TB, overlap = false, fontsize = 10]
node [shape = box, style = filled, fontname = Helvetica]
# Regroupement fonctionnel
subgraph cluster_0 {
label = 'Fonctions de calcul';
node [fillcolor = lightcoral];
calcul_vol_bille; cubage; relation_h_d; prob_coupe;
}
subgraph cluster_1 {
label = 'Fonctions de paramétrage';
node [fillcolor = lightskyblue]; # Alternative à lightgreen
param_coupe; param_ht; param_vol;
}
subgraph cluster_2 {
label = 'Fonctions utilitaires';
node [fillcolor = lightblue];
get_diam; get_modele; correction_biais;
}
# Connexions basées sur vos données et information
calcul_vol_bille -> get_diam;
calcul_vol_bille -> get_modele;
prob_coupe -> param_coupe;
relation_h_d -> param_ht;
cubage -> param_vol;
get_diam -> correction_biais;
get_modele -> correction_biais;
}
")
rm(list = ls())
